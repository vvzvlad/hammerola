# Shared secret CI sends as `Authorization: Bearer <token>` when publishing a
# build. Required — the service refuses to start without it. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PUBLISH_TOKEN=your_publish_token_here

# Guards READING the comment queue and marking items resolved (SPEC 7A.2).
# Required — the service refuses to start without it. Reading the queue back
# needs a token because it is raw input from anyone who found the page. Use a
# different value from PUBLISH_TOKEN: this one goes to the agent's MCP server,
# that one to CI.
#
# Leaving a comment is PUBLIC and needs no token TODAY — carried over as-is from
# cad_snapshot_hub, not a property this project keeps. SPEC 8A.1 reverses it, and
# step 0 of the plan (AGENTS.md) puts the write side behind a token as well; this
# file gains a variable for it then.
COMMENT_READ_TOKEN=your_comment_read_token_here

# Ceilings on the public comment endpoint (SPEC 7A.4). Not secrets, and every
# one of them has a sane default — set one only to tighten it.
# COMMENT_MAX_TEXT_CHARS=4000
# COMMENT_MAX_PHOTO_BYTES=8388608    # 8 MiB, per photo and per rendered frame
# COMMENT_MAX_BODY_BYTES=20971520    # 20 MiB for the whole multipart body
# COMMENT_MAX_PER_BUILD=100          # comments one build may collect
# COMMENT_MAX_TOTAL=5000             # comments the whole hub may hold
# COMMENT_RATE_LIMIT=5               # comments per address per window
# COMMENT_RATE_WINDOW_SECONDS=600

# Listening socket. Behind Traefik the container port is what the compose label
# `loadBalancer.server.port` points at, so leave 8000 unless you change both.
# HOST=0.0.0.0
# PORT=8000

# Where accepted builds are stored. All mutable state lives here; in production
# this path is the docker volume mounted at /app/data.
# DATA_DIR=data

# Keep this many newest builds per project. The build `latest` points at is never
# pruned, even when it falls out of the window. Local builds need no setting of
# their own: `<pid>/dev/` is ONE directory that every laptop push overwrites
# (SPEC 7.6), so nothing about it accumulates.
# RETENTION_BUILDS=20

# Ceiling on one uploaded build, applied to the compressed body and to the total
# uncompressed size. 64 MiB.
# MAX_BUILD_BYTES=67108864

LOG_LEVEL=INFO
