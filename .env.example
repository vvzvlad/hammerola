# Shared secret a publisher sends as `Authorization: Bearer <token>` when pushing
# a model source. Required — the service refuses to start without it. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PUBLISH_TOKEN=your_publish_token_here

# Your own neighbouring service — no default in code, so the address is required
# here (and as `environment:` on prod).
# MY_BACKEND_URL=http://localhost:8000

# Public external service — the default lives in code, overriding is optional.
# GOOGLE_API_URL=https://www.googleapis.com

LOG_LEVEL=INFO
