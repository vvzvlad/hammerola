# THE secret — one for the whole system (decided 2026-08-27, issue #26).
# Sent as `Authorization: Bearer <token>` and it means "may change things here":
# publish a build, read a build's sources and log, rename a project, remove one,
# read the comment queue, leave a comment, resolve one, read a project's
# proposal, store it, remove it. Required — the service refuses to start
# without it. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# THE SAME STRING IS WHAT PEOPLE USE. `hammerola login` stores it on a laptop
# (under this same name, in ~/.config/hammerola/env), and the browser UI takes
# it in its own box to turn "View only" into "Editing on". There is no second
# key and no per-person key: the hub compares this one string for equality and
# records nothing about who presented it.
#
# There were TWO variables here until step 0 of the plan — PUBLISH_TOKEN and
# COMMENT_READ_TOKEN. If you are updating an existing deployment: drop both and
# set this one. Nothing else changes, and a model repository's own CI keeps
# working untouched, because what it sends is the VALUE in an Authorization
# header — whatever its own workflow calls the secret it reads.
EDIT_TOKEN=your_edit_token_here

# Ceilings on the comment endpoint (SPEC 7A.4). Not secrets, and every one of
# them has a sane default — set one only to tighten it. All three are about SIZE.
# COMMENT_MAX_TEXT_CHARS=4000
# COMMENT_MAX_PHOTO_BYTES=8388608    # 8 MiB, per photo and per rendered frame
# COMMENT_MAX_BODY_BYTES=20971520    # 20 MiB for the whole multipart body
#
# There is no COMMENT_MAX_PER_BUILD, no COMMENT_MAX_TOTAL and no
# COMMENT_RATE_LIMIT any more, and nothing is missing here (SPEC 7A.4,
# 2026-08-27). All three guarded a comment endpoint anybody who knew the URL
# could post to; writing takes EDIT_TOKEN now, and whoever holds EDIT_TOKEN can
# also erase the whole project in one request — throttling them refuses the
# sixth comment of a review and prevents nothing. The count ceilings went the
# way retention did (SPEC 5.3): the volume is allowed to grow.

# Listening socket. Behind Traefik the container port is what the compose label
# `loadBalancer.server.port` points at, so leave 8000 unless you change both.
# HOST=0.0.0.0
# PORT=8000

# Where accepted builds are stored. All mutable state lives here; in production
# this path is the docker volume mounted at /app/data.
# DATA_DIR=data

# There is no retention setting, and there is nothing missing here: a published
# build is never deleted (SPEC 5.3, 7.3). The volume grows with every push and
# that is the accepted trade — clearing space is a deliberate manual act.

# Ceiling on one uploaded build, applied to the compressed body and to the total
# uncompressed size. 64 MiB.
# MAX_BUILD_BYTES=67108864

# The proposal panel on the build page: a rough body somebody assembles out of
# numbers over the model — a motor to clear, a wall to bolt to, an example of the
# layout they want — and sends to the agent as comment text. Off unless this line
# says otherwise, and that is the point of it: the feature is still being tried
# out, so a hub that never heard of this variable does not serve it. With it off
# the panel is not on the page at all. One value for the whole hub, decided at
# startup — there is nothing per-project and nothing a reader can turn on from
# the browser.
# PROPOSAL_PANEL=true
#
# IT USED TO BE CALLED SKETCH_PANEL, and a hub still carrying that name comes up
# with the panel off and says nothing about it: settings are read with
# `extra="ignore"`, so an unknown variable is not an error. Rename it.

# The ceiling on the body of the request that STORES a project's proposal. Far
# smaller than the comment endpoint's, and for a plain reason: a proposal carries
# no images — it is a few dozen lines of numbers — so a body anywhere near this
# is not one this panel wrote. Nothing counts proposals and nothing expires them;
# there is one per project and it stands until somebody removes it.
# PROPOSAL_MAX_BODY_BYTES=262144     # 256 KiB

LOG_LEVEL=INFO
